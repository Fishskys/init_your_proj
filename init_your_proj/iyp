#!/usr/bin/env python3
"""init_your_proj 入口（源码模式的包内镜像）：允许从仓库内任意位置启动。

等价于仓库根的 `iyp`；保留一份在包目录内，便于 `python3 init_your_proj/iyp` 直接跑。
"""
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_PARENT = os.path.dirname(_HERE)  # 工具仓库根
os.environ.setdefault("IYP_HOME", _PARENT)
for p in (_PARENT, _HERE):
    if p not in sys.path:
        sys.path.insert(0, p)

from init_your_proj.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
