#!/usr/bin/env python3
"""init_your_proj 可执行入口：init_your_proj/iyp 或 init_your_proj/scripts/iyp

把本目录（或 scripts/）加入 PATH 后可直接用 `iyp <子命令>` 全局调用；
由 env 定位仓库根，与启动目录无关。
"""
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
# iyp 位于工具仓库根（init_your_proj/iyp），仓库根就是 _HERE 所在目录
_ROOT = _HERE
os.environ.setdefault("IYP_HOME", _ROOT)
for p in (_ROOT, os.path.join(_ROOT, "scripts")):
    if p not in sys.path:
        sys.path.insert(0, p)
try:
    from scripts.cli import main
except ImportError:
    from init_your_proj.cli import main  # 兼容旧目录名

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
